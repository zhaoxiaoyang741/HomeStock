{
  // 这是给远端 ~/.openclaw/openclaw.json 合并用的“精简版本”。
  // 这里只保留 home-inventory 组件接入所需的最小字段。
  // 其他现有配置保持不动，不要整体覆盖。

  "agents": {
    "list": [
      {
        "id": "inventory",
        "name": "HomeStock Inventory",
        "workspace": "/home/pico/.openclaw/workspace-inventory",
        "agentDir": "/home/pico/.openclaw/agents/inventory",
        "model": {
          "primary": "minimax-portal/MiniMax-M2.7"
        },
        "skills": [
          "inbound_stock",
          "consume_material",
          "query_inventory",
          "update_stock_lot",
          "check_homestock_service"
        ],
        "tools": {
          "profile": "messaging",
          "alsoAllow": [
            "inbound_stock",
            "consume_material",
            "query_inventory",
            "update_stock_lot",
            "check_homestock_service"
          ]
        }
      }
    ]
  },

  "bindings": [
    {
      "agentId": "inventory",
      "match": {
        "channel": "feishu",
        "accountId": "*"
      }
    }
  ],

  "tools": {
    "alsoAllow": [
      "inbound_stock",
      "consume_material",
      "query_inventory",
      "update_stock_lot",
      "check_homestock_service"
    ]
  },

  "plugins": {
    "entries": {
      "home-inventory": {
        "enabled": true,
        "config": {
          "baseUrl": "http://192.168.18.13:8888"
        }
      }
    },
    "allow": [
      "home-inventory"
    ]
  }
}
