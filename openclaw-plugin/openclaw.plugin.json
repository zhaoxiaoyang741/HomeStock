      }
    },
    "additionalProperties": false
  },
  "uiHints": {
    "baseUrl": {
      "label": "后台 API 地址",
      "placeholder": "http://192.168.1.x:8888",
      "help": "HomeStock 后台服务的完整 URL"
    }
  }
}
